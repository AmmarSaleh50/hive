  "keywords": ["claude", "claude-code", "anthropic", "dashboard", "ai-agents", "developer-tools", "self-hosted", "tailscale"],
  "main": "server.cjs",
  "bin": { "hive": "server.cjs" },
  "files": ["server.cjs", "demo.cjs", "public/", "hive.config.example.json", "scripts/"],
  "scripts": {
