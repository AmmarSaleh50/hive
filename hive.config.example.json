{
  "port": 4747,
  "extraPorts": [80],
  "claudeDir": "~/.claude",
  "claudeBin": "",
  "summaries": {
    "enabled": true,
    "model": "haiku",
    "openEverySeconds": 12,
    "backgroundEverySeconds": 300
  },
  "closedHours": 6,
  "clips": [
    { "path": "~/Videos/Clips", "label": "Gameplay" }
  ],
  "tailscale": true,
  "dataDir": "./data",
  "machine": "desktop",
  "peers": [
    { "name": "laptop", "url": "https://laptop.your-tailnet.ts.net" }
  ],
  "launchFrom": "this-computer",
  "resume": {
    "days": 14,
    "command": "claude --resume {id}",
    "background": "claude --bg --resume {id}",
    "window": "0"
  },
  "routines": [
    {
      "name": "Work",
      "icon": "briefcase",
      "steps": [
        { "label": "Docker", "open": "C:/Program Files/Docker/Docker/Docker Desktop.exe", "unlessRunning": "Docker Desktop" },
        { "label": "Waiting for Docker", "waitFor": "docker info", "timeout": 240 },
        { "label": "Database", "run": "docker start my-postgres my-redis" },
        { "label": "API", "tab": { "title": "API", "cwd": "~/code/my-app/backend", "command": "npm run dev" } },
        { "label": "Web", "tab": { "title": "Web", "cwd": "~/code/my-app/frontend", "command": "npm run dev" } }
      ]
    }
  ]
}
